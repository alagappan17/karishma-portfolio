{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio project record",
  "type": "object",
  "required": ["slug", "title", "category", "industry", "platform", "summary", "tags", "theme", "featured", "image"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "shortTitle": { "type": "string" },
    "category": { "type": "string" },
    "industry": { "type": "string" },
    "role": { "type": ["string", "null"] },
    "duration": { "type": ["string", "null"] },
    "platform": { "type": "string" },
    "tools": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "theme": { "enum": ["blue", "butter", "ink", "lilac", "paper"] },
    "featured": { "type": "boolean" },
    "image": { "type": "object", "required": ["alt", "src"], "properties": { "alt": { "type": "string" }, "src": { "type": "string" } } }
  }
}
